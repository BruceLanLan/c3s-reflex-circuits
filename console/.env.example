# Copy to .env and fill in locally. Never commit the filled-in file: .gitignore
# already excludes it, and no token belongs in a repository.

# Where the circuits repository is checked out (for the verified netlist and encoder).
C3S_REPO=~/work/c3s-reflex

# The duty console.
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8765

# Only needed for the Telegram relay. The bot reads it from the environment and
# stores it nowhere.
TELEGRAM_TOKEN=
CONSOLE_URL=http://127.0.0.1:8765

# Chat ids (comma-separated) allowed to write the tool layer's bits with /block and
# /confirm. Leave empty unless a chat really is a separate, trusted layer: a chat the
# agent itself types into is the agent's channel, and a boundary it can satisfy is not
# a boundary.
TOOL_LAYER_CHATS=
