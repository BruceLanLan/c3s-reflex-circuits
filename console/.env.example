# Copy to .env and fill in locally. Never commit the filled-in file: .gitignore
# already excludes it, and no token belongs in a repository.

# Where the circuits repository is checked out (for the verified netlist and encoder).
C3S_REPO=~/work/c3s-reflex

# The duty console.
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8765

# Only needed for the Telegram relay. The bot reads it from the environment and
# stores it nowhere.
TELEGRAM_TOKEN=
CONSOLE_URL=http://127.0.0.1:8765

# Chat ids (comma-separated) of a person, separate from any agent: only these may use
# /pending, /confirm, /block, /stop, and only these are told when something starts
# waiting for a person. Leave empty unless a chat really is a separate, trusted layer: a chat the
# agent itself types into is the agent's channel, and a boundary it can satisfy is not
# a boundary.
TOOL_LAYER_CHATS=

# The Cardputer as a physical confirm key over USB: 1 finds /dev/cu.usbmodem*, or give a port.
REFLEX_CARDPUTER=

# --- the console's own files and secrets -------------------------------------------
# Everything the console writes lives here (default ~/.c3s-circuit-agent): policies.json,
# operator-token, agents.json, devices.json, tool-classes.txt, irreversible-tools.txt.
REFLEX_CONFIG_DIR=
# The operator token gates the person's bits and the rules. Left empty, the console
# generates one into $REFLEX_CONFIG_DIR/operator-token (mode 600) and prints where.
REFLEX_OPERATOR_TOKEN=
# Set to 1 to answer only agent names a person has bound (`c3s token bind --agent NAME`).
# Default off: an unbound name keeps working from this machine, which is the compatibility
# promise; over the LAN a name must always be bound and send its token.
REFLEX_REQUIRE_AGENT_TOKEN=
# Docker only: the host's address as the agent container sees it, when it is not
# `host-gateway` (colima / Lima: 192.168.5.2; docs/ISOLATION.md has the one-line check).
REFLEX_HOST_IP=

# --- the adapters (Claude Code hook, MCP proxy, SDK shims) -------------------------
# Which console to ask, and the name the agent appears under.
REFLEX_CONSOLE=http://127.0.0.1:8765
REFLEX_AGENT=
# The agent's own token once its name is bound (I-3). Never the operator token.
REFLEX_AGENT_TOKEN=
# Docker only: the one project directory mounted into the agent's container at /work.
REFLEX_WORKSPACE=
# 1 forwards gated calls when the console is unreachable. Default: refuse (fail closed).
REFLEX_FAIL_OPEN=
