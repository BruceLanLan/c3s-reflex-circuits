{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BruceLanLan/c3s-reflex-circuits/blob/main/patterns/pattern.schema.json",
  "title": "c3s.pattern/1",
  "description": "One pattern record: a stimulus, the escape reflex arc's exact per-tick answer to it, and who found it. See patterns/README.md. Records are produced by scripts/pattern_replay.py --emit, never typed by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "title", "question", "how_found", "discoverer", "date", "circuit", "stimulus", "result", "trace", "geometry", "replay"],
  "properties": {
    "format": { "const": "c3s.pattern/1" },
    "id": {
      "type": "string",
      "pattern": "^p[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "pNNN-short-name, and the file name in patterns/records."
    },
    "title": { "type": "string", "minLength": 1 },
    "question": {
      "type": "string",
      "minLength": 1,
      "description": "What was asked, in plain words."
    },
    "how_found": {
      "type": "string",
      "minLength": 1,
      "description": "The search: the grid, the criterion and the tie-break, stated precisely enough for someone else to redo it."
    },
    "discoverer": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "What the record shows, and anything it does not."
    },
    "circuit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "policy", "netlist_sha256", "domain_chain_sha256", "encoding", "tick_ms"],
      "properties": {
        "name": { "const": "core-hand-abc" },
        "policy": { "const": "policy-hand-abc" },
        "netlist_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The netlist SHA-256 in circuits/loom-escape/core-hand-abc.json."
        },
        "domain_chain_sha256": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$",
          "description": "The 32-byte whole-domain digest: the SHA-256 chain over all 2**23 rows of the step relation, as contracts/test/fixtures/circuits.json pins it. This is the reflex arc's name."
        },
        "encoding": { "const": "4bit-log" },
        "tick_ms": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "stimulus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "l_over_v_ms", "azimuth_deg", "start_deg", "end_deg"],
      "properties": {
        "kind": { "const": "loom" },
        "l_over_v_ms": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Half-size over approach speed, in milliseconds: the one parameter of a constant-velocity looming disc."
        },
        "azimuth_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "description": "Negative is left. Each eye sees its own hemifield plus 30 degrees across the midline."
        },
        "start_deg": { "const": 10.0, "description": "Fixed by the firmware's geometry." },
        "end_deg": { "const": 170.0, "description": "Fixed by the firmware's geometry." }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticks", "ended", "takeoff_tick", "states_entered"],
      "properties": {
        "ticks": { "type": "integer", "minimum": 1 },
        "ended": { "enum": ["hold", "raising wings", "short-mode takeoff", "long-mode takeoff", "no takeoff"] },
        "takeoff_tick": { "type": ["integer", "null"], "minimum": 0 },
        "states_entered": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 63 },
          "uniqueItems": true
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "sha256", "rows"],
      "properties": {
        "fields": { "const": ["tick", "sensory", "policy", "state", "motor", "next_state"] },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of rows serialised as canonical JSON: sorted keys, no whitespace, UTF-8. The geometry is deliberately not covered."
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "description": "One row per tick, all integers: tick index; the 17 input bits (16 sensory plus the standing bit 16); the policy's two pathway bits; the six latch bits before the tick; the motor command 0-3; the six latch bits after.",
          "items": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": [
              { "type": "integer", "minimum": 0 },
              { "type": "integer", "minimum": 0, "maximum": 131071 },
              { "type": "integer", "minimum": 0, "maximum": 3 },
              { "type": "integer", "minimum": 0, "maximum": 63 },
              { "type": "integer", "minimum": 0, "maximum": 3 },
              { "type": "integer", "minimum": 0, "maximum": 63 }
            ]
          }
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["informational", "note", "fields", "first_tick", "last_tick"],
      "description": "Angular size and expansion speed, which each host computes with its own atan and tan. Compared with a tolerance; never hashed.",
      "properties": {
        "informational": { "const": true },
        "note": { "type": "string", "minLength": 1 },
        "fields": { "const": ["tick", "theta_deg", "dtheta_dps"] },
        "first_tick": { "$ref": "#/$defs/geometryRow" },
        "last_tick": { "$ref": "#/$defs/geometryRow" }
      }
    },
    "replay": {
      "type": "string",
      "minLength": 1,
      "description": "The command that checks this record."
    }
  },
  "$defs": {
    "geometryRow": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": [
        { "type": "integer", "minimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "minimum": 0 }
      ]
    }
  }
}
